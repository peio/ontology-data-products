    dcterms:identifier "icb-subsector-assignments.csv" ;
    dcterms:title "Provisional ICB subsector assignments"@en ;
    skos:editorialNote "Provisional: each subsector was chosen from the ICB taxonomy labels based on the company's main business. Verify against FTSE Russell before production use."@en ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> .

