# F1: does FIBO have a term for a company's revenue? Search every class label.
# Run with --add ontologies/QuickFIBOProd.ttl.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX gwf:  <https://graphwise.ai/ontology/estx50-fibo/>

SELECT ?class ?label WHERE {
  ?class a owl:Class ; rdfs:label ?label .
  FILTER(REGEX(STR(?label), "revenue|turnover", "i") || LCASE(STR(?label)) = "income")
  FILTER(!STRSTARTS(STR(?class), STR(gwf:)))
}
ORDER BY ?label
