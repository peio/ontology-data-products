    skos:definition "indicates the reference against which a quantity can be expressed with respect to a number" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit> a owl:ObjectProperty ;
    rdfs:label "has measurement unit" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    rdfs:subPropertyOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementReference> ;
    skos:definition "indicates the unit against which a quantity can be expressed in a quantity value" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasNumericValue> a owl:DatatypeProperty ;
    rdfs:label "has numeric value" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> ;
    rdfs:range xsd:decimal ;
    skos:definition "indicates a particular magnitude or designation for a given observable characteristic that is a number" .

lcc-cr:GeographicRegion a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:Location ;
    skos:definition "an area, especially part of a country or the world having definable characteristics but not always fixed boundaries" .

lcc-cr:GeopoliticalEntity a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:GeographicRegion ;
    skos:definition "any country, federal province, city or other administrative unit that represents a geophysical location and has some political identity" .

lcc-cr:Location a owl:Class ;
    rdfs:label "location" ;
    rdfs:isDefinedBy lcc-cr: ;
    skos:definition "a place or position in time and/or space, including virtual place" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> a owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
    skos:definition "associates a name, reference name, or appellation with an individual concept" .

fibo-fnd-acc-cur:CurrencyIdentifier a owl:Class ;
    rdfs:label "currency identifier" ;
    rdfs:isDefinedBy fibo-fnd-acc-cur: ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement>,
        cmns-id:Identifier ;
    skos:definition "sequence of characters representing some currency" .

fibo-ind-mkt-bas:ReferenceIndex a owl:Class ;
    rdfs:label "reference index"@en ;
    rdfs:isDefinedBy fibo-ind-mkt-bas: ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> ;
    skos:definition "measure of change in the value of the contents of a basket over a given period of time"@en .

cmns-cls:characterizes a owl:ObjectProperty ;
    rdfs:label "characterizes" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subPropertyOf cmns-dsg:describes ;
    skos:definition "provides a discriminating feature or quality of" .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/CodesAndCodeSets/> ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "sequence of characters denoting something for some purpose, within a specified context, according to some rule set" .

<https://www.omg.org/spec/Commons/Collections/Arrangement> a owl:Class ;
    rdfs:label "arrangement" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/Collections/> ;
    skos:definition "systematic plan, manner, or method for making, doing, achieving, or organizing something" .

cmns-dt:DatePeriod a owl:Class ;
    rdfs:label "date period" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TimeInterval ;
    skos:definition "time span over one or more calendar days" .

cmns-dt:TemporalEntity a owl:Class ;
    rdfs:label "temporal entity" ;
    rdfs:isDefinedBy cmns-dt: ;
    skos:definition "time interval or instant" .

cmns-dt:TimeInterval a owl:Class ;
    rdfs:label "time interval" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TemporalEntity ;
    skos:definition "segment of the time axis, a location in time, with an extent or duration" .

cmns-dsg:isDescribedBy a owl:ObjectProperty ;
    rdfs:label "is described by" ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "has general nature or description of" .

cmns-id:Identifier a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:isDefinedBy cmns-id: ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "sequence of characters uniquely identifying that with which it is associated" .

cmns-loc:GeographicRegion a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "geographic region" ;
    skos:definition "area of land that has common features" .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Party> a owl:Class ;
    rdfs:label "party" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/PartiesAndSituations/> ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> ;
    skos:definition "person or organization" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementReference> a owl:Class ;
    rdfs:label "measurement reference" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Reference> ;
    skos:definition "measurement unit, measurement procedure, reference material, or a combination of such" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> a owl:Class ;
    rdfs:label "measurement unit" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementReference>,
        <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> ;
    skos:definition "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasEnglishName> a owl:DatatypeProperty ;
    rdfs:label "has English name" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/> ;
    rdfs:subPropertyOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> ;
    skos:definition "associates a name in English with an individual concept" .

fibo-fnd-acc-cur:Currency a owl:Class ;
    rdfs:label "currency" ;
    rdfs:isDefinedBy fibo-fnd-acc-cur: ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    skos:definition "medium of exchange value, defined by reference to the geographical location of the monetary authorities responsible for it" .

cmns-dsg:Designation a owl:Class ;
    rdfs:label "designation" ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "representation for something, or for a conceptualization thereof, that denotes it in a domain or subject" .

<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> a owl:DatatypeProperty ;
    rdfs:label "has text value" ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/TextDatatype/> ;
    skos:definition "provides a string value for something, with or without a language tag" .

lcc-cr:Country a owl:Class ;
    rdfs:label "country" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:GeopoliticalEntity ;
    skos:definition "a geopolitical entity representing a country or dependent territory" .

