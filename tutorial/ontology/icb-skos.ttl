@prefix icb:     <https://graphwise.ai/taxonomy/icb/> .
@prefix gw:      <https://graphwise.ai/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Industry Classification Benchmark (ICB) as a SKOS concept scheme.
# Source: first sheet ("New ICB Codes and Description") of icb-codes-description.xlsx.
# Hierarchy is derived from the code structure: each level appends two digits to its parent
#   Industry (2) > Supersector (4) > Sector (6) > Subsector (8 digits).
# Concept IRIs = namespace + ICB code; codes are also kept as skos:notation.

icb:scheme a skos:ConceptScheme , owl:Ontology ;
    skos:prefLabel "Industry Classification Benchmark (ICB)"@en ;
    dcterms:title "Industry Classification Benchmark (ICB)"@en ;
    dcterms:description "SKOS rendering of the four-level ICB taxonomy: 11 industries, 20 supersectors, 45 sectors and 173 subsectors."@en ;
    dcterms:source "icb-codes-description.xlsx, sheet 'New ICB Codes and Description'" ;
    dcterms:rightsHolder "FTSE International Limited (FTSE Russell)" ;
    rdfs:comment "ICB codes and names are the intellectual property of FTSE Russell; this file only re-expresses them in SKOS. Licence terms of the source data apply."@en ;
    dcterms:created "2026-10-28"^^xsd:date ;
    owl:versionIRI <https://graphwise.ai/taxonomy/icb/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    skos:hasTopConcept icb:10 , icb:15 , icb:20 , icb:30 , icb:35 , icb:40 , icb:45 , icb:50 , icb:55 , icb:60 , icb:65 .

# ---- Level collections -------------------------------------------------------

icb:industries a skos:Collection ;
    skos:prefLabel "ICB Industries"@en ;
    skos:definition "Level 1 of ICB: the broadest grouping (2-digit codes)."@en ;
    skos:member icb:10, icb:15, icb:20, icb:30, icb:35, icb:40, icb:45, icb:50 ,
        icb:55, icb:60, icb:65 .

icb:supersectors a skos:Collection ;
    skos:prefLabel "ICB Supersectors"@en ;
    skos:definition "Level 2 of ICB (4-digit codes)."@en ;
    skos:member icb:1010, icb:1510, icb:2010, icb:3010, icb:3020, icb:3030, icb:3510, icb:4010 ,
        icb:4020, icb:4030, icb:4040, icb:4050, icb:4510, icb:4520, icb:5010, icb:5020 ,
        icb:5510, icb:5520, icb:6010, icb:6510 .

icb:sectors a skos:Collection ;
    skos:prefLabel "ICB Sectors"@en ;
    skos:definition "Level 3 of ICB (6-digit codes)."@en ;
    skos:member icb:101010, icb:101020, icb:151010, icb:151020, icb:201010, icb:201020, icb:201030, icb:301010 ,
        icb:302010, icb:302020, icb:302030, icb:302040, icb:302050, icb:303010, icb:303020, icb:351010 ,
        icb:351020, icb:401010, icb:402010, icb:402020, icb:402030, icb:402040, icb:403010, icb:404010 ,
