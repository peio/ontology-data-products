icb:fibo-alignment a owl:Ontology ;
    dcterms:created "2026-10-28"^^xsd:date ;
    dcterms:description "Types every concept of the ICB SKOS scheme as a FIBO ICB classifier defined in FIBO's ICB scheme, so companies classified with cmns-cls:isClassifiedBy point to FIBO classifiers. FIBO has the ICB classifier class and the scheme individual but no ICB codes; the codes and the skos:broader hierarchy stay in icb-skos.ttl, which is unchanged."@en ;
    dcterms:title "ICB to FIBO alignment"@en ;
    owl:versionIRI <https://graphwise.ai/taxonomy/icb/fibo-alignment/1.0.0> ;
    owl:versionInfo "1.0.0" .

