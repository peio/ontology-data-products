# Replace NAME with the ontology's short name (e.g. estx50): one namespace per ontology.
# Replace CREATOR with the author's name.
# No owl:imports by default: align reused classes with rdfs:subClassOf, and add
# owl:imports only for what the Step 2 import plan lists.
@prefix gw:      <https://graphwise.ai/ontology/NAME/> .
@prefix gwi:     <https://graphwise.ai/instance/NAME/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

gw: a owl:Ontology ;
  dcterms:title "NAME Ontology" ;
  dcterms:creator "CREATOR" ;
  dcterms:publisher "Graphwise" ;
  owl:versionInfo "1.0.0" ;
  owl:versionIRI <https://graphwise.ai/ontology/NAME/1.0.0> .
